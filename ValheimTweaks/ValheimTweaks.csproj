<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>ValheimTweaks</AssemblyName>
    <RootNamespace>ValheimTweaks</RootNamespace>
    <LangVersion>latest</LangVersion>
    <!-- Single source of truth for the version is Plugin.PluginVersion. -->
    <Version>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\Plugin.cs')), '(?&lt;=PluginVersion = ")[^"]+'))</Version>
  </PropertyGroup>

  <!-- Thunderstore package. Team must match the author you enter when importing (and your thunderstore.io team if you publish). -->
  <PropertyGroup>
    <ThunderstoreTeam>thov88</ThunderstoreTeam>
    <ThunderstoreDescription>Configurable mining drop multipliers (iron scrap). Works with Configuration Manager.</ThunderstoreDescription>
    <ThunderstoreDependencies>"denikson-BepInExPack_Valheim-5.4.2351"</ThunderstoreDependencies>
    <PackageName>$(ThunderstoreTeam)-$(AssemblyName)</PackageName>
  </PropertyGroup>

  <PropertyGroup>
    <ManagedDir>$(ValheimDir)\valheim_Data\Managed</ManagedDir>
    <BepInExCoreDir>$(ProfileDir)\BepInEx\core</BepInExCoreDir>
  </PropertyGroup>

  <!-- Provided by the game / BepInEx at runtime, so never copied to the output. -->
  <ItemGroup>
    <Reference Include="BepInEx" HintPath="$(BepInExCoreDir)\BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(BepInExCoreDir)\0Harmony.dll" Private="false" />
    <Reference Include="assembly_valheim" HintPath="$(ManagedDir)\assembly_valheim.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(ManagedDir)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ManagedDir)\UnityEngine.CoreModule.dll" Private="false" />
  </ItemGroup>

  <!-- Release builds produce bin\<Team>-<Name>-<Version>.zip: import it in the mod manager or upload it to Thunderstore. -->
  <Target Name="PackageThunderstore" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <PackageStageDir>$(BaseOutputPath)Thunderstore\</PackageStageDir>
      <PackageZip>$(BaseOutputPath)$(PackageName)-$(Version).zip</PackageZip>
      <ManifestJson>{
  "name": "$(AssemblyName)",
  "version_number": "$(Version)",
  "website_url": "",
  "description": "$(ThunderstoreDescription)",
  "dependencies": [$(ThunderstoreDependencies)]
}</ManifestJson>
    </PropertyGroup>
    <RemoveDir Directories="$(PackageStageDir)" />
    <Copy SourceFiles="$(TargetPath);Thunderstore\README.md;Thunderstore\icon.png" DestinationFolder="$(PackageStageDir)" />
    <WriteLinesToFile File="$(PackageStageDir)manifest.json" Lines="$(ManifestJson)" Overwrite="true" />
    <ZipDirectory SourceDirectory="$(PackageStageDir)" DestinationFile="$(PackageZip)" Overwrite="true" />
    <Message Importance="high" Text="$(AssemblyName) -> $([System.IO.Path]::GetFullPath('$(PackageZip)'))" />
  </Target>

  <!-- After the package is imported, the mod manager owns plugins\<Team>-<Name>; keep that copy up to date on every build. -->
  <Target Name="DeployToProfile" AfterTargets="Build" Condition="'$(DeployToProfile)' == 'true'">
    <PropertyGroup>
      <DeployDir>$(ProfileDir)\BepInEx\plugins\$(PackageName)</DeployDir>
    </PropertyGroup>
    <Copy Condition="Exists('$(DeployDir)')" SourceFiles="$(TargetPath);$(TargetDir)$(TargetName).pdb" DestinationFolder="$(DeployDir)" SkipUnchangedFiles="true" />
    <Message Condition="Exists('$(DeployDir)')" Importance="high" Text="$(AssemblyName) -> $(DeployDir)" />
    <Message Condition="!Exists('$(DeployDir)')" Importance="high" Text="$(AssemblyName): not deployed, $(PackageName) isn't installed in the profile yet. Import the Release zip via the mod manager first." />
  </Target>

</Project>
